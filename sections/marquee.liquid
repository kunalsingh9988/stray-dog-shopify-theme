<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {%- for i in (1..2) -%}
      {%- assign items = section.settings.items | split: '|' -%}
      {%- for item in items -%}
        <span>{{ item | strip }}{% render 'icon', name: 'paw' %}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    { "type": "text", "id": "items", "label": "Items (separate with |)", "default": "Free US shipping over $75 | Every order helps rescue dogs | New drop live now" }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
