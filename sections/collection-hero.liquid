{%- liquid
  assign b = section.settings
  assign col = collections[b.collection] | default: collection
-%}
<div class="collection-split">
  <div class="collection-split__media">
    {%- if b.image != blank -%}
      <img src="{{ b.image | image_url: width: 1200 }}" alt="{{ b.heading | default: col.title | escape }}" width="1200" height="675">
    {%- elsif b.asset != blank -%}
      <img src="{{ b.asset | asset_url }}" alt="{{ b.heading | default: col.title | escape }}" width="1920" height="1083">
    {%- elsif col.image -%}
      <img src="{{ col.image | image_url: width: 1200 }}" alt="{{ col.title | escape }}" width="1200" height="675">
    {%- elsif col.products.first.featured_media -%}
      <img src="{{ col.products.first.featured_media | image_url: width: 1200 }}" alt="{{ col.title | escape }}" width="1200" height="675">
    {%- else -%}
      <img src="{{ 'hero-marina.webp' | asset_url }}" alt="{{ col.title | escape }}" width="1920" height="1083">
    {%- endif -%}
  </div>
  <div class="collection-split__body">
    <div class="collection-split__head">
      <h1>{{ b.heading | default: col.title }}</h1>
      <a class="t-link link-underline" href="{{ col.url | default: routes.all_products_collection_url }}">{{ b.link_label | default: 'Shop all' }}</a>
    </div>
    <div class="collection-split__grid">
      {%- if col != blank and col.products.size > 0 -%}
        {%- for product in col.products limit: b.preview_count -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- render 'demo-products', kind: b.demo_kind, limit: b.preview_count -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection hero",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (defaults to current)" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "asset", "label": "Asset fallback" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to collection title)" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "range", "id": "preview_count", "label": "Products shown", "min": 3, "max": 6, "step": 1, "default": 6 },
    { "type": "select", "id": "demo_kind", "label": "Demo products", "options": [
      { "value": "all", "label": "All" }, { "value": "new", "label": "New" },
      { "value": "hats", "label": "Hats" }, { "value": "shirts", "label": "Shirts" },
      { "value": "soon", "label": "Coming soon" }
    ], "default": "all" }
  ],
  "presets": [{ "name": "Collection hero" }]
}
{% endschema %}
