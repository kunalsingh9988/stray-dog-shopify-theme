{%- liquid
  assign b = section.settings
-%}
<div class="feature-hero">
  <div class="shero" style="height: {{ b.height }}px;">
    {%- if b.link != blank -%}<a class="shero__slide-link" href="{{ b.link }}">{%- endif -%}
    <div class="shero__media">
      {%- if b.image != blank -%}
        <img src="{{ b.image | image_url: width: 1920 }}" srcset="{{ b.image | image_url: width: 1200 }} 1200w, {{ b.image | image_url: width: 1920 }} 1920w" sizes="100vw" alt="{{ b.heading | escape }}" loading="lazy" width="1200" height="675">
      {%- elsif b.asset != blank -%}
        <img src="{{ b.asset | asset_url }}" alt="{{ b.heading | escape }}" loading="lazy" width="1920" height="1083">
      {%- endif -%}
    </div>
    {%- if b.link != blank -%}</a>{%- endif -%}
    <div class="shero__copy">
      {%- if b.heading != blank -%}<h2 class="t-hero">{{ b.heading }}</h2>{%- endif -%}
      {%- if b.text != blank -%}<p class="desc">{{ b.text }}</p>{%- endif -%}
    </div>
    {%- if b.btn1_label != blank or b.btn2_label != blank -%}
      <div class="shero__actions">
        {%- if b.btn1_label != blank -%}<a class="btn btn--ghost" href="{{ b.btn1_link | default: routes.all_products_collection_url }}">{{ b.btn1_label }}</a>{%- endif -%}
        {%- if b.btn2_label != blank -%}<a class="btn btn--ghost" href="{{ b.btn2_link | default: '/pages/about' }}">{{ b.btn2_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="tiles">
      {%- for block in section.blocks -%}
        {%- assign t = block.settings -%}
        <a class="tile" href="{{ t.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- if t.image != blank -%}
            <img src="{{ t.image | image_url: width: 800 }}" srcset="{{ t.image | image_url: width: 400 }} 400w, {{ t.image | image_url: width: 800 }} 800w" sizes="(max-width:749px) 50vw, 420px" alt="{{ t.label | escape }}" loading="lazy" width="800" height="1067">
          {%- elsif t.asset != blank -%}
            <img src="{{ t.asset | asset_url }}" alt="{{ t.label | escape }}" loading="lazy" width="800" height="1067">
          {%- endif -%}
          {%- if t.label != blank -%}<span class="tile__label">{{ t.label }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Feature hero + tiles",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "asset", "label": "Asset fallback", "info": "e.g. hero-steps.webp" },
    { "type": "range", "id": "height", "label": "Height", "min": 420, "max": 900, "step": 10, "unit": "px", "default": 864 },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Description" },
    { "type": "url", "id": "link", "label": "Slide link" },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Asset fallback" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature hero + tiles",
      "settings": { "asset": "hero-steps.webp", "heading": "Shop the drop", "btn1_label": "Shop now" }
    }
  ]
}
{% endschema %}
