<div class="page-wrap" style="max-width:720px;">
  <h1>{{ section.settings.heading }}</h1>
  {%- for block in section.blocks -%}
    <details style="border-bottom:1px solid var(--sd-border);padding:16px 0;" {{ block.shopify_attributes }}>
      <summary style="cursor:pointer;font-weight:700;font-size:12px;letter-spacing:0.6px;text-transform:uppercase;display:flex;justify-content:space-between;align-items:center;">
        {{ block.settings.q }}
        <span style="font-size:16px;font-weight:300;">+</span>
      </summary>
      <p style="padding-top:12px;font-weight:300;font-size:12px;line-height:19.2px;">{{ block.settings.a }}</p>
    </details>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" }],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "q", "label": "Question" },
        { "type": "textarea", "id": "a", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "q": "Where does my donation go?", "a": "A portion of every sale goes directly to dog rescues and shelters we partner with." } },
        { "type": "qa", "settings": { "q": "How do tees fit?", "a": "True to size with a relaxed coastal fit. Check the size guide on any product page." } },
        { "type": "qa", "settings": { "q": "When will my order ship?", "a": "Orders ship in 1–3 business days. Free US shipping over $75." } },
        { "type": "qa", "settings": { "q": "Can I return or exchange?", "a": "Yes — 30-day easy returns on unworn items." } }
      ]
    }
  ]
}
{% endschema %}
