<footer class="sd-footer">
  <div class="sd-footer__grid">
    <div>
      <h3>{{ 'general.newsletter.label' | t }}</h3>
      <a class="t-link link-underline" href="/pages/mission">Our mission</a>
      <div style="height:14px"></div>
      {%- form 'customer', class: 'newsletter-inline' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email' | t }}" required aria-label="{{ 'general.newsletter.email' | t }}">
        <button type="submit" aria-label="{{ 'general.newsletter.sign_up' | t }}">&rarr;</button>
        {%- if form.posted_successfully? -%}
          <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
      <p class="sd-footer__fine">
        By signing up you agree to the <a href="/policies/terms-of-service">terms and conditions</a>,
        <a href="/policies/privacy-policy">privacy policy</a>, and <a href="/policies/refund-policy">refund policy</a>.
      </p>
    </div>

    <div>
      <h3>Shop</h3>
      <ul>
        {%- if section.settings.shop_menu != blank and linklists[section.settings.shop_menu].links.size > 0 -%}
          {%- for link in linklists[section.settings.shop_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li>
          <li><a href="{{ collections['hats'].url | default: routes.all_products_collection_url }}">Hats</a></li>
          <li><a href="{{ collections['shirts'].url | default: routes.all_products_collection_url }}">Shirts</a></li>
          <li><a href="{{ collections['coming-soon'].url | default: routes.all_products_collection_url }}">Coming soon</a></li>
          <li><a href="{{ collections['new-arrivals'].url | default: routes.all_products_collection_url }}">New arrivals</a></li>
        {%- endif -%}
      </ul>
    </div>

    <div>
      <h3>Learn</h3>
      <ul>
        {%- if section.settings.learn_menu != blank and linklists[section.settings.learn_menu].links.size > 0 -%}
          {%- for link in linklists[section.settings.learn_menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="/pages/about">About us</a></li>
          <li><a href="/pages/mission">Our mission</a></li>
          <li><a href="/pages/community">The pack</a></li>
          <li><a href="/pages/contact">Contact us</a></li>
          <li><a href="{{ routes.search_url }}">Search</a></li>
        {%- endif -%}
      </ul>
    </div>

    <div>
      <h3>Help</h3>
      <ul>
        <li><a href="/policies/shipping-policy">Shipping</a></li>
        <li><a href="/policies/refund-policy">Returns</a></li>
        <li><a href="/pages/size-guide">Size guide</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
        <li><a href="/pages/contact">Support</a></li>
      </ul>
    </div>

    <div>
      <h3>Follow us</h3>
      <ul>
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
        {%- if settings.social_twitter != blank -%}<li><a href="{{ settings.social_twitter }}" target="_blank" rel="noopener">X (Twitter)</a></li>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener">YouTube</a></li>{%- endif -%}
      </ul>
      <div class="sd-footer__social" style="margin-top:16px;">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
        {%- if settings.social_twitter != blank -%}<a href="{{ settings.social_twitter }}" target="_blank" rel="noopener" aria-label="X">{% render 'icon', name: 'twitter' %}</a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
      </div>
    </div>
  </div>

  <div class="sd-footer__bar">
    <div class="legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <a href="/policies/privacy-policy">Privacy</a>
      <a href="/policies/terms-of-service">Terms</a>
      <a href="/policies/refund-policy">Refunds</a>
      <a href="/policies/shipping-policy">Shipping</a>
    </div>
    <div class="legal">
      <span>Every order helps rescue dogs</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "link_list", "id": "shop_menu", "label": "Shop menu" },
    { "type": "link_list", "id": "learn_menu", "label": "Learn menu" }
  ]
}
{% endschema %}
