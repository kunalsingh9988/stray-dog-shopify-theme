{%- liquid
  assign b = section.settings
  assign current_variant = product.selected_or_first_available_variant
  assign color_option = product.options_with_values | where: 'name', 'Color' | first
  assign size_option = product.options_with_values | where: 'name', 'Size' | first
  if color_option
    assign cpos = color_option.position | minus: 1
  endif
-%}

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>
  {% render 'icon', name: 'chevron-small' %}
  {%- if collection -%}
    <a href="{{ collection.url }}">{{ collection.title }}</a>
  {%- else -%}
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
  {%- endif -%}
  {% render 'icon', name: 'chevron-small' %}
  <span>{{ product.title }}</span>
</nav>

<div class="pdp" data-pdp {% if color_option %}data-color="{{ current_variant.options[cpos] | default: color_option.values.first }}"{% endif %}>
  {%- comment -%} Thumbnail rail {%- endcomment -%}
  <div class="pdp__thumbs">
    {%- for media in product.media limit: 8 -%}
      <button class="pdp__thumb{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}">
        <img src="{{ media | image_url: width: 80 }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy" width="80" height="80">
      </button>
    {%- endfor -%}
  </div>

  {%- comment -%} Stacked gallery {%- endcomment -%}
  <div class="pdp__gallery">
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        <div class="pdp__media" data-index="{{ forloop.index0 }}">
          <img
            src="{{ media | image_url: width: 1000 }}"
            srcset="{{ media | image_url: width: 640 }} 640w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1600 }} 1600w"
            sizes="(max-width:989px) 88vw, 46vw"
            alt="{{ media.alt | default: product.title | escape }}"
            {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
            width="{{ media.width }}" height="{{ media.height }}">
        </div>
        {%- if forloop.index == 2 and product.media.size == 2 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <div class="pdp__media" data-index="0"><img src="{{ 'tee-script-white.webp' | asset_url }}" alt="{{ product.title | escape }}" width="1200" height="1200"></div>
      <div class="pdp__media" data-index="1"><img src="{{ 'hero-beach.webp' | asset_url }}" alt="{{ product.title | escape }}" width="1920" height="1083"></div>
    {%- endif -%}
  </div>

  {%- comment -%} Sticky buy panel {%- endcomment -%}
  <div class="pdp__panel">
    <h1>{{ product.title }}</h1>
    <p class="pdp__price" id="PdpPrice">
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <s>{{ current_variant.compare_at_price | money }}</s><span class="price-sale">{{ current_variant.price | money }}</span>
      {%- else -%}
        {{ current_variant.price | money }}
      {%- endif -%}
    </p>

    {%- if color_option -%}
      <div class="pdp__row">
        <p class="pdp__optlabel"><span>Color: <span id="PdpColorName">{{ current_variant.options[cpos] | default: color_option.values.first }}</span></span></p>
        <div class="pdp__swatches">
          {%- assign opt_key = 'option' | append: color_option.position -%}
          {%- for value in color_option.values -%}
            {%- assign variant_for_value = product.variants | where: opt_key, value | first -%}
            <span class="swatch{% if current_variant.options contains value %} active{% endif %}">
              <button type="button" class="pdp__swatch" data-value="{{ value | escape }}" {% if variant_for_value %}data-url="{{ variant_for_value.url }}"{% endif %} style="width:21px;height:21px;border-radius:10.5px;padding:0;" aria-label="{{ value }}">
                <span style="display:block;width:100%;height:100%;border-radius:10.5px;background-color:{{ value.swatch.color | default: '#cccccc' }};{% if value.swatch.image %}background-image:url({{ value.swatch.image | image_url: width: 42 }});background-size:cover;{% endif %}"></span>
              </button>
            </span>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if b.fit != blank -%}
      <div class="pdp__row">
        <p class="pdp__optlabel"><span>Fit: {{ b.fit }}</span></p>
      </div>
    {%- endif -%}

    <form action="{{ routes.cart_add_url }}" method="post" data-ajax-atc data-needs-size="{% if size_option %}1{% else %}0{% endif %}" style="margin-top:18px;">
      <input type="hidden" name="id" id="PdpVariantId" value="{{ current_variant.id }}">
      {%- if size_option -%}
        <div class="pdp__optlabel">
          <span>Size:</span>
          <button type="button" data-open-size-guide>{{ 'products.product.view_size_guide' | t }}</button>
        </div>
        <div class="pdp__sizes" role="radiogroup" aria-label="{{ 'products.product.size' | t }}">
          {%- for value in size_option.values -%}
            <button type="button" class="pdp__size" data-value="{{ value | escape }}" role="radio" aria-checked="false">{{ value }}</button>
          {%- endfor -%}
        </div>
        <button type="button" class="pdp__missing" data-open-size-guide>{{ 'products.product.dont_see_size' | t }}</button>
      {%- endif -%}

      <button type="submit" id="PdpAtc" class="btn btn--full pdp__atc {% unless current_variant.available %}btn--disabled{% endunless %}" {% unless current_variant.available %}disabled{% endunless %}>
        {%- if current_variant.available -%}
          {%- if size_option -%}{{ 'products.product.select_size' | t }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </button>
    </form>

    {%- if b.limit_note != blank -%}
      <p class="pdp__limit">{{ b.limit_note }}</p>
    {%- endif -%}

    <div class="pdp__tabs">
      <div class="pdp__tablist" role="tablist">
        <button role="tab" aria-selected="true" aria-controls="tab-desc" id="tabbtn-desc">{{ 'products.product.description' | t }}</button>
        <button role="tab" aria-selected="false" aria-controls="tab-fit" id="tabbtn-fit">{{ 'products.product.size_fit' | t }}</button>
        <button role="tab" aria-selected="false" aria-controls="tab-ship" id="tabbtn-ship">{{ 'products.product.shipping_returns' | t }}</button>
      </div>
      <div role="tabpanel" id="tab-desc" aria-labelledby="tabbtn-desc">
        <div class="rte">
          <h4>{{ 'products.product.editors_note' | t }}</h4>
          {%- if product.description != blank -%}
            {{ product.description }}
          {%- else -%}
            <p style="margin-top:12px;">{{ b.fallback_description }}</p>
          {%- endif -%}
        </div>
        <ul>
          {%- assign bullets = b.bullets | split: '|' -%}
          {%- for bullet in bullets -%}
            {%- if bullet != blank -%}<li>{{ bullet | strip }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div role="tabpanel" id="tab-fit" aria-labelledby="tabbtn-fit" hidden>
        <div class="rte"><h4>Size &amp; fit</h4><p style="margin-top:12px;">{{ b.size_fit_text }}</p></div>
        <ul>
          <li>True to size</li>
          <li>Model wears size M</li>
          <li>Heavyweight 6.5oz cotton</li>
          <li>Pre-shrunk</li>
        </ul>
      </div>
      <div role="tabpanel" id="tab-ship" aria-labelledby="tabbtn-ship" hidden>
        <div class="rte"><h4>Shipping &amp; returns</h4><p style="margin-top:12px;">{{ b.shipping_text }}</p></div>
        <ul>
          <li>Free US shipping over $75</li>
          <li>Ships in 1–3 business days</li>
          <li>30-day easy returns</li>
          <li>A portion of every sale is donated</li>
        </ul>
      </div>
    </div>

    {%- comment -%} Complete the look {%- endcomment -%}
    {%- liquid
      assign upsells = product.metafields.custom.complete_the_look.value
      assign upsell_col = collections[b.upsell_collection]
    -%}
    <div class="ctl">
      <h2>{{ 'products.product.complete_the_look' | t }}</h2>
      {%- if upsells != blank -%}
        {%- for p in upsells limit: 2 -%}
          {%- render 'ctl-item', product: p -%}
        {%- endfor -%}
      {%- elsif upsell_col != blank and upsell_col.products.size > 0 -%}
        {%- for p in upsell_col.products limit: 2 -%}
          {%- unless p.id == product.id -%}{%- render 'ctl-item', product: p -%}{%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- render 'ctl-item', title: 'Script Trucker Hat — Gold', price: '$40.00', image: 'hat-script-gold.webp', color: 'Gold / Black' -%}
        {%- render 'ctl-item', title: 'Essential Script Tee — Cream', price: '$34.00', image: 'tee-script-cream.webp', color: 'Cream' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} Related products {%- endcomment -%}
{%- liquid
  assign rel_col = collections[b.related_collection] | default: collection
-%}
<div class="section-head">
  <h2>{{ 'products.product.related_products' | t }}</h2>
</div>
<div class="product-grid" style="padding-bottom:10px;">
  {%- if rel_col != blank and rel_col.products.size > 0 -%}
    {%- assign shown = 0 -%}
    {%- for p in rel_col.products limit: 8 -%}
      {%- unless p.id == product.id -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- render 'product-card', product: p -%}
        {%- if shown == 4 -%}{%- break -%}{%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- else -%}
    {%- render 'demo-products', kind: 'all', limit: 4 -%}
  {%- endif -%}
</div>

{%- comment -%} Variant data + modals {%- endcomment -%}
<script type="application/json" id="PdpVariants">
  [
    {%- for v in product.variants -%}
      { "id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available }}, "price": {{ v.price }}, "compare_at_price": {{ v.compare_at_price | default: 0 }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<div id="SizeGuideModal" class="sd-modal" role="dialog" aria-modal="true">
  <div class="sd-modal__box">
    <button class="sd-modal__close" aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <h3>Size guide</h3>
    <table>
      <tr><th>Size</th><th>Chest (in)</th><th>Length (in)</th></tr>
      <tr><td>XS</td><td>34–36</td><td>26</td></tr>
      <tr><td>S</td><td>36–38</td><td>27</td></tr>
      <tr><td>M</td><td>38–40</td><td>28</td></tr>
      <tr><td>L</td><td>40–42</td><td>29</td></tr>
      <tr><td>XL</td><td>42–44</td><td>30</td></tr>
      <tr><td>XXL</td><td>44–46</td><td>31</td></tr>
    </table>
    <p style="margin-top:14px;font-weight:300;">{{ b.size_guide_note }}</p>
  </div>
</div>

<div id="ZoomModal" class="sd-modal zoom-modal" role="dialog" aria-modal="true">
  <img alt="Zoomed product image" width="1200" height="1200">
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "fit", "label": "Fit label", "default": "Regular" },
    { "type": "text", "id": "limit_note", "label": "Limit note", "default": "Limited to 5 units per customer" },
    { "type": "textarea", "id": "fallback_description", "label": "Fallback description", "default": "The Stray Dog essential — heavyweight cotton, a relaxed coastal fit, and the signature script at the chest. Built to be lived in, on and off the water." },
    { "type": "textarea", "id": "bullets", "label": "Spec bullets (separate with |)", "default": "Heavyweight 6.5oz cotton | Signature Stray Dog script | Relaxed coastal fit | Pre-shrunk, garment-dyed | Screen-printed by hand | Style: SD-TEE-001" },
    { "type": "textarea", "id": "size_fit_text", "label": "Size & fit text", "default": "Fits true to size with a relaxed drape. Take your usual size for the intended fit, or size up for extra room." },
    { "type": "textarea", "id": "shipping_text", "label": "Shipping text", "default": "Orders ship within 1–3 business days. Free US shipping on orders over $75. Returns accepted within 30 days." },
    { "type": "textarea", "id": "size_guide_note", "label": "Size guide note", "default": "Between sizes? Size up for a roomier fit." },
    { "type": "collection", "id": "upsell_collection", "label": "Complete-the-look collection" },
    { "type": "collection", "id": "related_collection", "label": "Related products collection" }
  ]
}
{% endschema %}
