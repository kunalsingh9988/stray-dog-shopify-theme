<div class="slideshow" data-interval="{{ section.settings.interval | times: 1000 }}">
  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    <div class="shero sher__slide{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
      {%- if b.link != blank -%}<a class="shero__slide-link" href="{{ b.link }}">{%- endif -%}
      <div class="shero__media">
        {%- if b.image != blank -%}
          <img src="{{ b.image | image_url: width: 1920 }}" srcset="{{ b.image | image_url: width: 1200 }} 1200w, {{ b.image | image_url: width: 1920 }} 1920w, {{ b.image | image_url: width: 2880 }} 2880w" sizes="100vw" alt="{{ b.heading | default: 'Stray Dog' | escape }}"{% unless forloop.first %} loading="lazy"{% endunless %} fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}" width="1200" height="675">
        {%- elsif b.asset != blank -%}
          <img src="{{ b.asset | asset_url }}" srcset="{{ b.asset | asset_url }} 1920w" sizes="100vw" alt="{{ b.heading | default: 'Stray Dog' | escape }}"{% unless forloop.first %} loading="lazy"{% endunless %} width="1920" height="1083">
        {%- endif -%}
      </div>
      {%- if b.link != blank -%}</a>{%- endif -%}
      <div class="shero__copy">
        {%- if b.heading != blank -%}<h2 class="t-hero">{{ b.heading }}</h2>{%- endif -%}
        {%- if b.text != blank -%}<p class="desc">{{ b.text }}</p>{%- endif -%}
      </div>
      {%- if b.btn1_label != blank or b.btn2_label != blank -%}
        <div class="shero__actions">
          {%- if b.btn1_label != blank -%}<a class="btn btn--ghost" href="{{ b.btn1_link | default: routes.all_products_collection_url }}">{{ b.btn1_label }}</a>{%- endif -%}
          {%- if b.btn2_label != blank -%}<a class="btn btn--ghost" href="{{ b.btn2_link | default: '/pages/about' }}">{{ b.btn2_label }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
  <div class="shero__dots" role="tablist" aria-label="Slides"></div>
</div>

{% schema %}
{
  "name": "Hero slideshow",
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Asset fallback (filename in assets)", "info": "Used when no image is picked — e.g. hero-beach.webp" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "url", "id": "link", "label": "Slide link" },
        { "type": "text", "id": "btn1_label", "label": "Button 1 label" },
        { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
        { "type": "text", "id": "btn2_label", "label": "Button 2 label" },
        { "type": "url", "id": "btn2_link", "label": "Button 2 link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [
        { "type": "slide", "settings": { "asset": "hero-beach.webp", "heading": "Stray Dog — Summer Drop", "text": "Coastal tees and trucker hats made for slow mornings, salt air, and good dogs.", "btn1_label": "Shop now", "btn2_label": "Learn more" } },
        { "type": "slide", "settings": { "asset": "hero-steps.webp", "heading": "The Pack Essentials", "text": "Everyday staples for the ones who rescue, roam, and ride along.", "btn1_label": "Shop now" } },
        { "type": "slide", "settings": { "asset": "hero-marina.webp", "heading": "Built for the Water", "text": "A portion of every sale goes to rescues and shelters.", "btn1_label": "Shop now", "btn2_label": "Our mission" } }
      ]
    }
  ]
}
{% endschema %}
