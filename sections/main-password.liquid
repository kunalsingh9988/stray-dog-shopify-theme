<h1 class="t-hero" style="color:#fff;">Stray Dog is almost here</h1>
<p style="font-weight:300;letter-spacing:1.2px;text-transform:uppercase;margin-top:14px;color:rgba(255,255,255,.75);">Something good is coming. Leave your email to join the pack.</p>
{%- form 'customer', class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="password,newsletter">
  <input type="email" name="contact[email]" placeholder="Email address" required style="height:46px;">
  <button class="btn" type="submit" style="height:46px;">Notify me</button>
  {%- if form.posted_successfully? -%}<p class="form-success">You're on the list.</p>{%- endif -%}
{%- endform -%}
<div style="margin-top:40px;">
  {%- form 'storefront_password' -%}
    <input type="password" name="password" placeholder="Store password" style="height:40px;border:1px solid rgba(255,255,255,.5);background:transparent;color:#fff;padding:0 12px;">
    <button class="t-link" type="submit" style="color:#fff;margin-left:12px;text-decoration:underline;">Enter</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
