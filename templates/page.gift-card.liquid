{% assign pdp_url = collections.all.products.first.url | default: routes.all_products_collection_url %}


  <div class="page">
    <div class="page__head">
      <p class="page__kicker">[ FOR THE STRAY IN YOUR LIFE ]</p>
      <h1 class="page__title">Gift Card</h1>
      <p class="page__sub">Delivered by email · never expires · funds rescue dogs like everything else.</p>
    </div>
    <div class="gift">
      <div class="gift__well"><img width="636" height="352" src="assets/straydog-logo-white.png" alt="Stray Dog gift card"></div>
      <div class="gift__panel">
        <div>
          <h3>Amount</h3>
          <div class="sizes" data-gift-amounts>
            <button class="size-pill active" data-amt="25">$25</button>
            <button class="size-pill" data-amt="50">$50</button>
            <button class="size-pill" data-amt="75">$75</button>
            <button class="size-pill" data-amt="100">$100</button>
          </div>
        </div>
        <button class="atc" data-gift-atc><span>Add gift card</span><span data-gift-price>$25.00</span></button>
        <p class="mono" style="font-size:12px;line-height:1.7">Digital only — code lands in the inbox seconds after checkout. Works on every product, combines with shipping discounts, never expires.</p>
      </div>
    </div>
  </div>

