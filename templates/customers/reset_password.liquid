<div class="page">
  <div class="page__head">
    <p class="page__kicker">[ CUSTOMER ]</p>
    <h1 class="page__title">Reset password</h1>
    <p class="page__sub">Set a new password for {{ reset_password.email }}.</p>
  </div>
  {%- form 'reset_customer_password', class: 'form-grid', style: 'margin:0 auto' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="rp-pass">New password</label><input id="rp-pass" name="customer[password]" type="password" required autocomplete="new-password"></div>
    <div class="field"><label for="rp-pass2">Confirm password</label><input id="rp-pass2" name="customer[password_confirmation]" type="password" required autocomplete="new-password"></div>
    <button class="btn-primary" type="submit">Reset password</button>
  {%- endform -%}
</div>
