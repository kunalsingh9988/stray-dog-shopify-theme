<div class="page">
  <div class="page__head">
    <p class="page__kicker">[ CUSTOMER ]</p>
    <h1 class="page__title">Activate account</h1>
    <p class="page__sub">Set your password to join the pack.</p>
  </div>
  {%- form 'activate_customer_password', class: 'form-grid', style: 'margin:0 auto' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ac-pass">Password</label><input id="ac-pass" name="customer[password]" type="password" required autocomplete="new-password"></div>
    <div class="field"><label for="ac-pass2">Confirm password</label><input id="ac-pass2" name="customer[password_confirmation]" type="password" required autocomplete="new-password"></div>
    <button class="btn-primary" type="submit">Activate account</button>
  {%- endform -%}
</div>
