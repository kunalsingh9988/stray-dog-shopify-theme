<div class="page-wrap" style="max-width:480px;">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div style="display:flex;flex-direction:column;gap:14px;">
      <input type="text" name="customer[first_name]" placeholder="{{ 'customer.register.first_name' | t }}" style="height:44px;border:1px solid var(--sd-text);padding:0 14px;">
      <input type="text" name="customer[last_name]" placeholder="{{ 'customer.register.last_name' | t }}" style="height:44px;border:1px solid var(--sd-text);padding:0 14px;">
      <input type="email" name="customer[email]" placeholder="{{ 'customer.register.email' | t }}" required style="height:44px;border:1px solid var(--sd-text);padding:0 14px;">
      <input type="password" name="customer[password]" placeholder="{{ 'customer.register.password' | t }}" required style="height:44px;border:1px solid var(--sd-text);padding:0 14px;">
      <button class="btn btn--full" type="submit">{{ 'customer.register.submit' | t }}</button>
      <a class="t-link link-underline" href="{{ routes.account_login_url }}">{{ 'customer.login_page.sign_in' | t }}</a>
    </div>
  {%- endform -%}
</div>
