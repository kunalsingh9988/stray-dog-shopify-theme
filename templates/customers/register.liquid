<div class="page">
  <div class="page__head">
    <p class="page__kicker">[ CUSTOMER ]</p>
    <h1 class="page__title">Create account</h1>
  </div>
  {%- form 'create_customer', class: 'form-grid', style: 'margin:0 auto' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="rg-first">First name</label><input id="rg-first" name="customer[first_name]" type="text" required autocomplete="given-name"></div>
    <div class="field"><label for="rg-last">Last name</label><input id="rg-last" name="customer[last_name]" type="text" autocomplete="family-name"></div>
    <div class="field"><label for="rg-email">Email</label><input id="rg-email" name="customer[email]" type="email" required autocomplete="email"></div>
    <div class="field"><label for="rg-pass">Password</label><input id="rg-pass" name="customer[password]" type="password" required autocomplete="new-password"></div>
    <button class="btn-primary" type="submit">Join the pack</button>
    <a class="pill" href="{{ routes.account_login_url }}" style="justify-self:center">Already in the pack? Sign in</a>
  {%- endform -%}
</div>
