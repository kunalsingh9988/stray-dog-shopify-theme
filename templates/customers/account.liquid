<div class="page">
  <div class="page__head">
    <p class="page__kicker">[ CUSTOMER ]</p>
    <h1 class="page__title">Account</h1>
    <p class="page__sub">{{ customer.name }} · {{ customer.email }}</p>
  </div>
  <div class="auth">
    <div>
      <h2 class="auth__title">Orders</h2>
      {%- if customer.orders.size > 0 -%}
        {%- for order in customer.orders -%}
          <div class="cart-item">
            <div><p class="cart-item__name"><a href="{{ order.customer_url }}">{{ order.name }}</a></p>
            <p class="cart-item__price">{{ order.created_at | date: '%b %d, %Y' }} · {{ order.financial_status_label }}</p></div>
            <div class="cart-item__side"><span class="cart-item__name">{{ order.total_price | money }}</span></div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <p class="cart__empty" style="text-align:left">No orders yet — time to fix that.</p>
        <a class="btn-primary" href="{{ routes.all_products_collection_url }}" style="margin-top:16px">Shop the drop</a>
      {%- endif -%}
    </div>
    <div>
      <h2 class="auth__title">Details</h2>
      <p class="mono-block" style="margin:10px 0 18px">{{ customer.name }}
{{ customer.email }}</p>
      <p><a class="pill" href="{{ routes.account_addresses_url }}" style="background:var(--pill)">View addresses</a></p>
      <p style="margin-top:14px"><a href="{{ routes.account_logout_url }}" style="font-family:var(--font-mono);font-size:12px;text-transform:uppercase;text-decoration:underline">Log out</a></p>
    </div>
  </div>
</div>
