      "settings": { "interval": 6 },
      "blocks": {
        "s1": {
          "type": "slide",
          "settings": {
            "asset": "hero-beach.webp",
            "heading": "Stray Dog — Summer Drop",
            "text": "Coastal tees and trucker hats made for slow mornings, salt air, and good dogs.",
            "btn1_label": "Shop now",
            "btn1_link": "shopify://collections/all",
            "btn2_label": "Learn more",
            "btn2_link": "shopify://pages/about"
          }
