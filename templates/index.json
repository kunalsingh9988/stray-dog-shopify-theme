        "s2": {
          "type": "slide",
          "settings": {
            "asset": "hero-steps.webp",
            "heading": "The Pack Essentials",
            "text": "Everyday staples for the ones who rescue, roam, and ride along.",
            "btn1_label": "Shop now",
            "btn1_link": "shopify://collections/all"
          }
        },
        "s3": {
          "type": "slide",
          "settings": {
            "asset": "hero-marina.webp",
            "heading": "Built for the Water",
            "text": "A portion of every sale goes to dog rescues and shelters.",
            "btn1_label": "Shop now",
            "btn1_link": "shopify://collections/all",
            "btn2_label": "Our mission",
            "btn2_link": "shopify://pages/mission"
          }
