      "type": "split-feature",
      "settings": {
        "asset": "hero-marina.webp",
        "eyebrow": "Our mission",
        "heading": "Every order helps a stray",
        "text": "Stray Dog started with a crew of friends, a love of the water, and a soft spot for dogs that needed a home.",
        "text2": "A portion of every sale goes straight to rescues and shelters — so every tee, every hat, helps a stray find its people.",
        "btn_label": "Read our story",
        "btn_link": "shopify://pages/mission",
        "dark": true
      }
    },
    "community": {
      "type": "community-gallery",
      "settings": {
        "heading": "The pack",
        "sub": "Tag @straydogclothing to get featured.",
        "link_label": "Join us",
        "link_url": "shopify://pages/community"
