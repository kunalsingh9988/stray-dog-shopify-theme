      "blocks": {
        "c1": { "type": "photo", "settings": { "asset": "hero-beach.webp", "label": "@saltlife" } },
        "c2": { "type": "photo", "settings": { "asset": "hero-steps.webp", "label": "@dockdays" } },
        "c3": { "type": "photo", "settings": { "asset": "hero-sunset.webp", "label": "@goldenhrs" } },
        "c4": { "type": "photo", "settings": { "asset": "hero-marina.webp", "label": "@harbor" } }
      },
      "block_order": ["c1", "c2", "c3", "c4"]
    },
    "about": {
      "type": "split-feature",
      "settings": {
        "asset": "hero-motel.webp",
        "flip": true,
        "eyebrow": "About us",
        "heading": "Run by friends, powered by dogs",
        "text": "We're a small crew who grew up on the water — fishing, surfing, and picking up strays along the way. Stray Dog is our way of giving back.",
        "text2": "Every piece is made to be lived in: heavyweight cotton, coastal colors, and the signature stray script.",
        "btn_label": "Meet the crew",
        "btn_link": "shopify://pages/about"
      }
    },
    "values": {
      "type": "values",
      "blocks": {
        "v1": { "type": "value", "settings": { "heading": "Rescue first", "text": "A portion of every sale is donated to dog rescues and shelters." } },
        "v2": { "type": "value", "settings": { "heading": "Made for the water", "text": "Built by a crew of friends who live on boats, boards, and beaches." } },
        "v3": { "type": "value", "settings": { "heading": "The pack", "text": "Real people, real dogs, real trips — our community wears the brand." } }
      },
      "block_order": ["v1", "v2", "v3"]
    },
    "email": {
      "type": "newsletter",
      "settings": {
        "heading": "Join the pack",
