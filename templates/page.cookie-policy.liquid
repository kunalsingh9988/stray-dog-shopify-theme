{% assign pdp_url = collections.all.products.first.url | default: routes.all_products_collection_url %}


  <div class="page">
    <div class="page__head">
      <p class="page__kicker">[ LEGAL ]</p>
      <h1 class="page__title">Cookie Policy</h1>
      <p class="page__sub mono">LAST UPDATED: OCT 2026</p>
    </div>
    <div class="prose">
      <h2>What cookies we use</h2>
      <table class="size-table">
        <tr><th>Cookie</th><th>Purpose</th><th>Duration</th></tr>
        <tr><td>cart</td><td>Keeps your cart between visits</td><td>30 days</td></tr>
        <tr><td>session</td><td>Login / checkout session</td><td>Session</td></tr>
        <tr><td>analytics</td><td>Anonymous page stats</td><td>12 months</td></tr>
        <tr><td>prefs</td><td>Remembers announce-bar dismissal</td><td>30 days</td></tr>
      </table>
      <h2>What we don't do</h2>
      <p>No ad-network trackers, no cross-site profiling, no selling attention data.</p>
      <h2>Managing cookies</h2>
      <p>Block or delete cookies in your browser settings anytime — the shop still works, you'll just lose your saved cart.</p>
    </div>
  </div>

