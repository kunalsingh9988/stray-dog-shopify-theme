{% comment %}
  Renders a product card.
  Accepts: product (product object)
     OR:   title, price, image (asset filename), badge, swatches (csv hex), url
{% endcomment %}

{%- if product != blank -%}
  <div class="product-card">
    <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 640 }}"
          srcset="{{ product.featured_media | image_url: width: 320 }} 320w, {{ product.featured_media | image_url: width: 640 }} 640w, {{ product.featured_media | image_url: width: 960 }} 960w"
          sizes="(max-width: 749px) 68vw, 305px"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          loading="lazy" width="640" height="640">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if product.available == false -%}
        <span class="product-card__badge product-card__badge--soon">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
      {%- endif -%}
    </a>
    <div class="product-card__info">
      <p class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></p>
      <p class="product-card__price">
        {%- if product.compare_at_price > product.price -%}
          <s>{{ product.compare_at_price | money }}</s><span class="price-sale">{{ product.price | money }}</span>
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </p>
      {%- assign color_option = product.options_with_values | where: 'name', 'Color' | first -%}
      {%- if color_option.values.size > 1 -%}
        <div class="product-card__swatches">
          {%- for value in color_option.values limit: 4 -%}
            <span class="swatch{% if forloop.first %} active{% endif %}">
              <span style="background-color: {{ value.swatch.color | default: '#cccccc' }};{% if value.swatch.image %}background-image:url({{ value.swatch.image | image_url: width: 42 }});{% endif %}"></span>
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
  {%- assign durl = url | default: routes.all_products_collection_url -%}
  <div class="product-card">
    <a class="product-card__media" href="{{ durl }}" aria-label="{{ title | escape }}">
      <img src="{{ image | asset_url }}" alt="{{ title | escape }}" loading="lazy" width="640" height="640">
      {%- if badge != blank -%}
        <span class="product-card__badge{% if badge == 'Coming soon' %} product-card__badge--soon{% endif %}">{{ badge }}</span>
      {%- endif -%}
    </a>
    <div class="product-card__info">
      <p class="product-card__title"><a href="{{ durl }}">{{ title }}</a></p>
      <p class="product-card__price">{{ price }}</p>
      {%- if swatches != blank -%}
        <div class="product-card__swatches">
          {%- assign sws = swatches | split: ',' -%}
          {%- for sw in sws limit: 4 -%}
            <span class="swatch{% if forloop.first %} active{% endif %}"><span style="background-color: {{ sw | strip }}"></span></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
