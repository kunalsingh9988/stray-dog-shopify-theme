<footer class="sd2-footer" id="site-footer">
  <div class="sd2-footer__grid">
    <div class="sd2-footer__brand">
      <img width="636" height="352" class="sd2-footer__logo" src="assets/straydog-logo-black.png" alt="Stray Dog">
      <p class="mono">Rescue Club <span data-clock>12:36</span></p>
    </div>
    <div class="sd2-footer__col">
      <p>Legal</p>
      <ul>
        <li><a class="pill" href="/policies/terms-of-service">Terms of Service</a></li>
        <li><a class="pill" href="/policies/refund-policy">Shipping &amp; Returns</a></li>
        <li><a class="pill" href="/policies/privacy-policy">Privacy Policy</a></li>
        <li><a class="pill" href="/pages/cookie-policy">Cookie Policy</a></li>
      </ul>
    </div>
    <div class="sd2-footer__col">
      <p>Customer</p>
      <ul>
        <li><a class="pill" href="{{ routes.account_login_url }}">Login</a></li>
        <li><a class="pill" href="/pages/size-guide">Size Guide</a></li>
        <li><a class="pill" href="/pages/faq">FAQ</a></li>
        <li><a class="pill" href="/pages/contact">Contact</a></li>
      </ul>
    </div>
    <div class="sd2-footer__col">
      <p>Brand</p>
      <ul>
        <li><a class="pill" href="/pages/mission">Our Mission</a></li>
        <li><a class="pill" href="/pages/community">Community</a></li>
        <li><a class="pill" href="/pages/about">About</a></li>
        <li><a class="pill" href="/pages/lookbook">Lookbook</a></li>
      </ul>
    </div>
    <div class="sd2-footer__col">
      <p>More</p>
      <ul>
        <li><a class="pill" href="/pages/gift-card">Gift Card</a></li>
        <li><a class="pill" href="/pages/accessibility">Accessibility</a></li>
      </ul>
    </div>
  </div>

  <div class="sd2-footer__row">
    <p class="mono">Follow us</p>
    <div class="socials">
      <a class="pill" href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="16" height="16" rx="4.5"/><circle cx="10" cy="10" r="4"/><circle cx="15" cy="5" r="1" fill="currentColor" stroke="none"/></svg></a>
      <a class="pill" href="https://www.tiktok.com/" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M13.8 2h2.6c.2 1.7 1.3 2.9 3 3.1v2.7c-1.1 0-2.1-.3-3-1v6.4A6.2 6.2 0 1 1 9.6 7v3a3.2 3.2 0 1 0 3.6 3.2V2z"/></svg></a>
      <a class="pill" href="https://www.youtube.com/" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="4.5" width="17" height="11" rx="3"/><path d="m8.5 7.7 4.3 2.3-4.3 2.3z" fill="currentColor" stroke="none"/></svg></a>
    </div>
  </div>

  {%- form 'customer', class: 'sd2-footer__sub' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input class="sub-input" type="email" name="contact[email]" placeholder="Email" aria-label="Email" required>
    <button class="btn-primary" type="submit">Subscribe</button>
    {%- if form.posted_successfully? -%}<p class="mono" style="font-size:12px;width:100%">You're in the pack — watch your inbox.</p>{%- endif -%}
  {%- endform -%}
  <div class="sub-legal">
    <input type="checkbox" id="foot-legal">
    <label for="foot-legal">I've read and accept the <a href="/policies/privacy-policy">Privacy Policy</a>.</label>
  </div>

  <div class="sd2-footer__base">
    <span>© 2026 • Stray Dog Clothing</span>
    <span>· Credits</span>
  </div>
</footer>